{
  "expo": {
    "name": "POS Bodega",
    "slug": "pos-bodega-mobile",
    "scheme": ["posbodega", "com.googleusercontent.apps.953316471021-fss1su32i361nm6np4i3guh3i473lf3g"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pos.bodega"
    },
    "android": {
      "package": "com.pos.bodega",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos la cámara para escanear el código de barras de tus productos."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ce0479f5-4c8f-4cdb-935f-b355c304d2a9"
      }
    },
    "owner": "jeykg"
  }
}
